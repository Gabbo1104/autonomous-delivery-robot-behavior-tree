flowchart TD
    root["-> Root"]
    root --> bat["? Batteria"]
    root --> ord["? Ordine"]
    root --> rit["? Raggiungi il punto di ritiro"]
    root --> pre["? Prendere l'oggetto"]
    root --> con["? Raggiungi il punto di consegna"]
    root --> pos("posa l'oggetto")
    root --> chi("chiudi l'ordine")

    bat --> batc(["C: livello > 20% oltre al ritorno e non in carica?"])
    bat --> ric["-> Ricarica"]
    ric --> rcar["? Raggiungi caricabatterie"]
    ric --> chg("charge (finisce solo al 100%)")
    rcar --> alc(["C: mi trovo al caricabatterie?"])
    rcar --> gtc("go to charge")

    ord --> ordc(["C: ho un ordine?"])
    ord --> att("attendi ordine")

    rit --> ritc1(["C: ho l'oggetto in mano?"])
    rit --> ritc2(["C: sono gia li?"])
    rit --> nav["-> Navigazione (un passo alla volta)"]

    pre --> prec(["C: ho gia l'oggetto in mano?"])
    pre --> pren("prendi")

    con --> conc(["C: sono gia li?"])
    con --> nav

    nav --> sca["? Scale"]
    nav --> str["? Strada"]
    nav --> ava("vai avanti")
    sca --> scac(["C: sono lontano dalle scale?"])
    sca --> allo("allontanati")
    str --> strc(["C: strada libera?"])
    str --> por["-> Porta"]
    str --> tor("torna indietro")
    por --> porc(["C: c'e una porta?"])
    por --> apr["? Apri porta"]
    apr --> spi["-> Spingi"]
    apr --> chiave("usa la chiave")
    spi --> spic(["C: bisogna spingere?"])
    spi --> spin("spingi")

    classDef seq fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a
    classDef sel fill:#ffedd5,stroke:#c2410c,color:#7c2d12
    classDef cond fill:#dcfce7,stroke:#15803d,color:#14532d
    classDef act fill:#f3e8ff,stroke:#7e22ce,color:#581c87
    class root,ric,nav,por,spi seq
    class bat,ord,rit,pre,con,rcar,sca,str,apr sel
    class batc,alc,ordc,ritc1,ritc2,prec,conc,scac,strc,porc,spic cond
    class pos,chi,chg,gtc,att,pren,ava,allo,tor,chiave,spin act
